# Copy this file to .env. Never commit real secrets.
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# Supabase project URL and server-side key.
# Required only when connecting to Supabase with persistence.
SUPABASE_URL=
SUPABASE_KEY=

# LLM Provider selection: "ollama" (default local), "gemini" (cloud API), or "auto" (Gemini with Ollama fallback).
LLM_PROVIDER=ollama

# Local model endpoint (Ollama).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Google Gemini API configuration (optional, used when LLM_PROVIDER is "gemini" or "auto").
# Requires a Google Gemini API key from Google AI Studio / Google Cloud (never commit real secrets).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT=30.0

# Telegram credentials (Phase 5).
# Required for live delivery with `geopulse brief --send`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT=15.0
